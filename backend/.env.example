# Service Ports (Defaults used in docker-compose.yml, override if needed)
RIDE_SERVICE_PORT=3000
DRIVER_SERVICE_PORT=3001
NOTIFICATION_SERVICE_PORT=3002
LOCATION_SERVICE_PORT=3003
PAYMENT_SERVICE_PORT=3004
AUTH_SERVICE_PORT=3005
USER_SERVICE_PORT=3006
SUPPORT_SERVICE_PORT=3007
ANALYTICS_SERVICE_PORT=3008
ADMIN_SERVICE_PORT=3009

# Database URIs (Defaults point to 'mongo' container)
RIDE_SERVICE_MONGODB_URI=mongodb://mongo:27017/ride_service
DRIVER_SERVICE_MONGODB_URI=mongodb://mongo:27017/driver_service
NOTIFICATION_SERVICE_MONGODB_URI=mongodb://mongo:27017/notification_service # Optional, if storing state
LOCATION_SERVICE_MONGODB_URI=mongodb://mongo:27017/location_service
DRIVER_SERVICE_MONGODB_URI_FOR_LOCATION=mongodb://mongo:27017/driver_service # Used by Location Service
PAYMENT_SERVICE_MONGODB_URI=mongodb://mongo:27017/payment_service
AUTH_SERVICE_MONGODB_URI=mongodb://mongo:27017/auth_service
USER_SERVICE_MONGODB_URI=mongodb://mongo:27017/user_service
SUPPORT_SERVICE_MONGODB_URI=mongodb://mongo:27017/support_service
ANALYTICS_SERVICE_MONGODB_URI=mongodb://mongo:27017/analytics_service
ADMIN_SERVICE_MONGODB_URI=mongodb://mongo:27017/admin_service

# Redis URL (Defaults point to 'redis' container)
REDIS_URL=redis://redis:6379

# Kafka Brokers (Defaults point to 'kafka' container internal address)
KAFKA_BROKERS=kafka:9092

# JWT Secret (REQUIRED - Change this to a strong, random secret)
JWT_SECRET=YourSuperSecretKeyForJWT

# Stripe API Keys (Replace with your test keys if using real Stripe integration)
# Keep as "sk_test_SIMULATED" to use the built-in simulation
STRIPE_SECRET_KEY=sk_test_SIMULATED
STRIPE_PUBLIC_KEY=pk_test_SIMULATED

# Driver Service Config
DRIVER_SEARCH_RADIUS_KM=5
DRIVER_BATCH_SIZE=3
DRIVER_BATCH_TTL_SECONDS=60 # Shorter TTL for faster retries

# Notification Service Config
DRIVER_OFFER_TIMEOUT_SECONDS=30

# Location Service Config
LOCATION_BATCH_INTERVAL_MS=60000 # 1 minute
LOCATION_BATCH_SIZE=50

# Admin Service Config (Default credentials for initial admin user)
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=password

# Admin Portal Frontend Config (URL pointing to the admin service backend)
# Used by Vite in the admin-portal container
VITE_ADMIN_SERVICE_URL=http://localhost:3009 # Use localhost here as frontend runs in browser
